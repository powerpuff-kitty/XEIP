{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/powerpuff-kitty/XEIP/schemas/capability.schema.json",
  "title": "XEIP capability descriptor 0.1",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.:-][a-z0-9-]+)*$"
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "spec": {
      "type": "string",
      "format": "uri"
    }
  },
  "additionalProperties": false
}
